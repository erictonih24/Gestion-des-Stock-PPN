# Copier ce fichier en .env puis remplir les valeurs
PORT=3000
NODE_ENV=development
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGER_MOI
# Compte administrateur créé au premier démarrage (mot de passe à changer à la 1re connexion)
ADMIN_USERNAME=admin
# Si le mot de passe contient #, entourez-le de guillemets : ADMIN_PASSWORD="abc#123"
ADMIN_PASSWORD=ChangezMoi2026
# Infos société imprimées sur les factures
COMPANY_NAME=Grossiste PPN
COMPANY_ADDRESS=Antananarivo, Madagascar
COMPANY_PHONE=
COMPANY_NIF=
COMPANY_STAT=
CURRENCY=Ar

# --- Base de données persistante (obligatoire sur Vercel) ---
# Créer une base Turso, puis : turso db show --url <nom>  /  turso db tokens create <nom>
# Si ces deux lignes sont vides, un fichier SQLite local (data/stock.db) est utilisé (développement uniquement).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
